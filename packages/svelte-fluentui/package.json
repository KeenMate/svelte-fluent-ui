{
	"name": "svelte-fluentui",
	"version": "1.0.0-rc11",
	"description": "A Svelte wrapper library for Microsoft FluentUI web components",
	"license": "MIT",
	"author": "KeenMate",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/KeenMate/svelte-fluentui.git"
	},
	"bugs": {
		"url": "https://github.com/KeenMate/svelte-fluentui/issues"
	},
	"homepage": "https://github.com/KeenMate/svelte-fluentui#readme",
	"scripts": {
		"dev": "svelte-package --watch",
		"package": "npm run package:pre-build && svelte-kit sync && svelte-package && npm run package:post-build && publint",
		"package:pre-build": "node scripts/pre-package.js",
		"package:post-build": "node scripts/post-package.js",
		"prepublishOnly": "npm run package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint ."
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"README.md"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./vite": {
			"types": "./dist/vite/index.d.ts",
			"default": "./dist/vite/index.js"
		},
		"./constants": {
			"types": "./dist/constants/index.d.ts",
			"default": "./dist/constants/index.js"
		},
		"./styles": "./dist/main.css",
		"./styles.scss": "./dist/main.scss",
		"./main": "./dist/main.scss",
		"./fluent-ui": "./dist/assets/styles/fluent-ui/main.scss",
		"./theme": "./dist/assets/styles/theme.scss",
		"./layout": "./dist/assets/styles/layout.scss",
		"./nav": "./dist/assets/styles/nav.scss",
		"./components": "./dist/assets/styles/components.scss",
		"./assets/*": "./dist/assets/*"
	},
	"peerDependencies": {
		"@fluentui/web-components": "^2.6.0",
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@fluentui/web-components": "^2.6.1",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.43.8",
		"@sveltejs/package": "^2.5.4",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"chokidar-cli": "^3.0.0",
		"concurrently": "^9.2.1",
		"five-server": "^0.4.5",
		"publint": "^0.3.13",
		"sass-embedded": "^1.93.2",
		"svelte": "^5.39.8",
		"svelte-check": "^4.3.2",
		"svelte-preprocess": "^6.0.3",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.45.0",
		"vite": "^7.1.9",
		"vite-plugin-dts": "^4.5.4",
		"vite-plugin-static-copy": "^3.1.3"
	},
	"keywords": [
		"svelte",
		"fluentui",
		"microsoft",
		"ui-components",
		"web-components",
		"design-system"
	],
	"dependencies": {
		"@fluentui/svg-icons": "^1.1.313",
		"esm-env": "^1.2.2"
	}
}
