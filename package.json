{
	"name": "svelte-fluentui",
	"version": "1.0.0-rc02",
	"description": "A Svelte wrapper library for Microsoft FluentUI web components",
	"license": "MIT",
	"author": "KeenMate",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/KeenMate/svelte-fluentui.git"
	},
	"bugs": {
		"url": "https://github.com/KeenMate/svelte-fluentui/issues"
	},
	"homepage": "https://github.com/KeenMate/svelte-fluentui#readme",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint ."
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.36.0",
		"@sveltejs/adapter-auto": "^6.1.1",
		"@sveltejs/kit": "^2.43.8",
		"@sveltejs/package": "^2.5.4",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"eslint": "^9.36.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.12.4",
		"globals": "^16.4.0",
		"live-server": "^1.2.2",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"publint": "^0.3.13",
		"svelte": "^5.39.8",
		"svelte-check": "^4.3.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.45.0",
		"vite": "^7.1.9"
	},
	"keywords": [
		"svelte",
		"fluentui",
		"microsoft",
		"ui-components",
		"web-components",
		"design-system"
	],
	"dependencies": {
		"@fluentui/web-components": "^2.6.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"esm-env": "^1.2.2",
		"sass-embedded": "^1.93.2",
		"svelte-preprocess": "^6.0.3"
	}
}
